{
  "name": "context-coder",
  "version": "1.4.3",
  "description": "Context Coder: MCP server providing secure file system operations with relative path handling for AI context management",
  "license": "MIT",
  "author": "khromov",
  "homepage": "https://github.com/khromov/context-coder",
  "type": "module",
  "bin": {
    "context-coder": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"fs.copyFileSync('instructions.md', 'dist/instructions.md'); for (const f of fs.readdirSync('dist')) if (f.endsWith('.js')) fs.chmodSync('dist/' + f, 0o755)\"",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:stdio": "COCO_MCP_TRANSPORT=stdio node dist/index.js --stdio",
    "start:http": "node dist/index.js",
    "start:edit": "node dist/index.js --edit-file-mode",
    "dev": "COCO_PORT=3002 COCO_DEV=true nodemon",
    "dev:stdio": "COCO_PORT=3002 COCO_DEV=true COCO_MCP_TRANSPORT=stdio nodemon --exec 'node dist/index.js --stdio'",
    "dev:edit": "COCO_PORT=3002 COCO_DEV=true nodemon --exec 'node dist/index.js --edit-file-mode'",
    "dev:ls": "COCO_PORT=3002 COCO_DEV=true nodemon --exec 'node dist/index.js ls'",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prepublishOnly": "npm run build",
    "cc-http": "npx context-coder --http",
    "check-updates": "npx npm-check-updates",
    "check-updates:upgrade": "npx npm-check-updates -u",
    "mcp": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai-digest": "^1.5.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.12",
    "minimatch": "^10.2.6",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
