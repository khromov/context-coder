#!/bin/sh
# Format the staged files Prettier handles, then re-stage only those files.
# (Re-staging with `git add -A` would also commit unrelated untracked files.)
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(src/.*\.ts|[^/]+\.(json|md))$' || true)
[ -z "$files" ] && exit 0
echo "$files" | xargs npx prettier --write
echo "$files" | xargs git add
